# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-me
# Comma-separated Telegram user ids allowed to use the bot (everyone else is ignored)
ALLOWED_USER_IDS=111111111
# --- Running on Windows with start.bat: PUBLIC_URL is filled in automatically by the tunnel. ---
# Tuna (default, https://tuna.am): create an API key with tunnel access in the dashboard (starts with tak_).
TUNA_API_KEY=
# Optional: your free permanent subdomain (the "Free" domain in the dashboard, e.g. brave-otter-4821).
# Leave empty and start.bat finds it by itself.
# TUNA_SUBDOMAIN=
# Optional: a proxy for the bot's Telegram traffic only (the tunnel always connects directly).
# TELEGRAM_PROXY=http://127.0.0.1:10809
# Optional: TUNNEL=cloudflared or TUNNEL=ngrok (with NGROK_AUTHTOKEN=...) instead of Tuna.
# TUNNEL=tuna
#
# --- Running on a server with Docker: your domain (Caddy gets the certificate) ---
PUBLIC_URL=https://todo.example.com
DOMAIN=todo.example.com
# Initial time zone for new users (change later with /settings)
DEFAULT_TZ=Europe/Berlin
# In-chat UI: auto (default) = HTML widgets, falling back to messages with buttons while
# Telegram refuses widgets (it does for ordinary bots since 13 Nov 2026); off = always buttons.
# WIDGETS=auto
# Pin each new preview message (see README; default off)
PIN_PREVIEW=false
# Optional
# PORT=8080
# DB_PATH=./data/todo.sqlite
# BACKUP_DIR=./data/backups
# LOG_LEVEL=info
