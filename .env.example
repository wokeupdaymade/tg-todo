# Telegram To-Do settings
# Lines starting with # are notes or switched-off settings: Telegram To-Do ignores them.
# To switch an optional setting on, delete the # at the start of its line and fill in the value.

# ===== Required: fill these in =====

# Bot token from @BotFather
BOT_TOKEN=
# Your Telegram user id (ask @userinfobot). Several ids: separate them with commas.
ALLOWED_USER_IDS=
# Your time zone, e.g. Europe/Moscow (can be changed later in the chat with /settings)
DEFAULT_TZ=Europe/Moscow
# Tuna API key (https://my.tuna.am -> API keys -> create one with tunnel access; it starts with tak_)
TUNA_API_KEY=

# ===== Optional =====

# Proxy for the bot's Telegram traffic only. The tunnel never uses it.
# TELEGRAM_PROXY=http://127.0.0.1:10809

# Your free permanent Tuna subdomain (e.g. brave-otter-4821). start.bat finds it by itself.
# TUNA_SUBDOMAIN=

# Another tunnel instead of Tuna: cloudflared, or ngrok (then also NGROK_AUTHTOKEN=...)
# TUNNEL=tuna

# In-chat UI: auto = widgets when Telegram allows them, otherwise messages with buttons; off = always buttons
# WIDGETS=auto

# Pin each new preview message in the chat
# PIN_PREVIEW=false

# PORT=8080
# LOG_LEVEL=info

# ===== Only for running on a Linux server with Docker (start.bat fills these in itself) =====
# PUBLIC_URL=https://todo.example.com
# DOMAIN=todo.example.com
