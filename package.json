{
  "name": "telegram-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "npm run build && node --disable-warning=ExperimentalWarning --env-file=.env src/main.ts",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webapp"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
